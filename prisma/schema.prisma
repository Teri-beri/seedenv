generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TESTER
  DEVELOPER
  ADMIN
}

enum RankTier {
  ALPHA_SEEDER
  CORE_VALIDATOR
  APEX_ARCHITECT
}

enum CohortType {
  STANDARD_QA
  GOOGLE_PLAY_14_DAY
  LIVE_STRESS_DROP
}

enum HardwareIntegrity {
  VERIFIED_PHYSICAL_NODE
  EMULATOR_FLAGGED
  UNVERIFIED
}

enum PlatformType {
  TESTFLIGHT
  WEB_STAGING
  PLAY_STORE
}

enum CampaignStatus {
  DRAFT
  ESCROW_PENDING
  ACTIVE
  PAUSED
  COMPLETED
}

enum TaskProofType {
  SCREENSHOT
  TEXT_FEEDBACK
  ACTION_LINK
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum TransactionType {
  CLIPPER_DEPOSIT
  CLIPPER_PAYOUT
  CLIPPER_REFUND
  ESCROW_DEPOSIT
  ESCROW_REFUND
  BALANCE_TOPUP
  BALANCE_WITHDRAWAL
  FUNDING_REVERSAL
  FUNDING_RESTORATION
  BOUNTY_PAYOUT
  PLATFORM_FEE
  WITHDRAWAL
}

enum CohortFundingModel {
  PREPAID
  PAY_PER_TESTER
}

enum SlotChargeStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  emailVerified             DateTime?
  name                      String?
  image                     String?
  passwordHash              String?
  sessionVersion            Int                  @default(0) @map("session_version")
  role                      UserRole             @default(TESTER)
  testerWorkspaceEnabled    Boolean              @default(false) @map("tester_workspace_enabled")
  developerWorkspaceEnabled Boolean              @default(false) @map("developer_workspace_enabled")
  username                  String               @default("SeedEnv Member")
  avatarUrl                 String?
  bio                       String?              @db.VarChar(200)
  portfolioUrl              String?
  companyName               String?
  productUrl                String?
  githubUsername            String?              @map("github_username")
  discordUrl                String?              @map("discord_url")
  twitterHandle             String?              @map("twitter_handle")
  notificationPreferences   Json                 @default("{\"email_tester_feedback\":true,\"email_ledger_updates\":true,\"email_announcements\":false}") @map("notification_preferences")
  discordWebhookUrl         String?              @map("discord_webhook_url")
  githubTokenEncrypted      String?              @map("github_token_encrypted")
  walletBalanceCents        Int                  @default(0)
  xpPoints                  Int                  @default(0)
  rankTier                  RankTier             @default(ALPHA_SEEDER)
  streakDays                Int                  @default(1)
  lastActiveDate            DateTime             @default(now())
  stripeCustomerId          String?
  fundingBalanceCents       Int                  @default(0) @map("funding_balance_cents")
  autoReloadCents           Int                  @default(0) @map("auto_reload_cents")
  platformFeeWaived         Boolean              @default(false) @map("platform_fee_waived")
  launchWizardDrafts        Json                 @default("{}") @map("launch_wizard_drafts")
  launchWizardDraftRevision Int                  @default(0) @map("launch_wizard_draft_revision")
  promoRedemptions          CohortPromoRedemption[]
  balanceTopUps             BalanceTopUp[]
  stripeConnectAccountId    String?
  questXp                   Int                  @default(0)
  discoveryPasses           Int                  @default(0)
  referralCode              String?              @unique
  developerReferralCode     String?              @unique @map("developer_referral_code")
  developerReferralsSent    DeveloperReferral[]  @relation("DeveloperReferrer")
  developerReferralReceived DeveloperReferral?   @relation("DeveloperReferred")
  ownedPromoCodes           CohortPromoCode[]
  questTheme                String               @default("classic")
  clipProfile               ClipProfile?
  clipCampaigns             ClipCampaign[]
  clipEngagements           ClipEngagement[]
  clipMessages              ClipMessage[]
  clipAssets                ClipAsset[]
  clipSocialAccounts        ClipSocialAccount[]
  clipOAuthStates           ClipOAuthState[]
  questRewards              QuestReward[]
  applications              MissionApplication[]
  referralsSent             Referral[]           @relation("ReferralInviter")
  referralReceived          Referral?            @relation("ReferralFriend")
  posts                     CommunityPost[]
  comments                  CommunityComment[]
  reports                   CommunityReport[]
  campaigns                 AppCampaign[]        @relation("DeveloperCampaigns")
  submissions               Submission[]         @relation("TesterSubmissions")
  transactions              WalletTransaction[]
  billingProfile            BillingProfile?
  supportTickets            SupportTicket[]
  accounts                  Account[]
  sessions                  Session[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([role])
  @@index([rankTier, xpPoints])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  refresh_token_expires_in Int?
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AppCampaign {
  id               String               @id @default(cuid())
  developerId      String
  developer        User                 @relation("DeveloperCampaigns", fields: [developerId], references: [id], onDelete: Cascade)
  title            String
  platform         PlatformType
  appUrl           String
  iconUrl          String?
  targetVibe       String
  description      String
  totalBudgetUsd   Float
  bountyPerTaskUsd Float
  platformFeeUsd   Float
  totalSlots       Int
  claimedSlots     Int                  @default(0)
  completedSlots   Int                  @default(0)
  status           CampaignStatus       @default(DRAFT)
  instructions     TaskInstruction[]
  instructionRevision Int              @default(1)
  instructionVersions CohortInstructionVersion[]
  submissions      Submission[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  expiresAt        DateTime
  discoveryAllowed Boolean              @default(false)
  discoveryMinRep  Int                  @default(0)
  cohortType       CohortType           @default(STANDARD_QA)
  guaranteedDays   Int?
  syncGitHubRepo   String?
  hardwareStrict   Boolean              @default(true)
  estimatedMinutes Int?                 @map("estimated_minutes")
  testerPerk       String?              @map("tester_perk") @db.VarChar(80)
  fundingModel     CohortFundingModel   @default(PREPAID) @map("funding_model")
  cancelledAt      DateTime?            @map("cancelled_at")
  refundedCents    Int                  @default(0) @map("refunded_cents")
  billingHoldCents Int                  @default(0) @map("billing_hold_cents")
  taxSnapshot      Json?
  applications     MissionApplication[]
  transactions     WalletTransaction[]
  slotCharges      SlotCharge[]
  synthesis        CampaignSynthesis?
  platformFeeDiscountPercent Int                @default(0) @map("platform_fee_discount_percent")
  promoCodeDraft   String?              @map("promo_code_draft") @db.VarChar(81)
  promoRedemptions CohortPromoRedemption[]

  @@index([developerId, status])
  @@index([status, expiresAt])
  @@index([platform])
}

model CohortPromoCode {
  id              String                  @id @default(cuid())
  code            String                  @unique @db.VarChar(40)
  discountPercent Int                     @map("discount_percent")
  maxRedemptions  Int                     @map("max_redemptions")
  reservedCount   Int                     @default(0) @map("reserved_count")
  expiresAt       DateTime?               @map("expires_at")
  ownerId         String?                @map("owner_id")
  owner           User?                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  enabled         Boolean                 @default(true)
  createdAt       DateTime                @default(now()) @map("created_at")
  redemptions     CohortPromoRedemption[]
}

model CohortPromoRedemption {
  id              String         @id @default(cuid())
  promoCodeId      String         @map("promo_code_id")
  promoCode        CohortPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  developerId     String         @map("developer_id")
  developer       User           @relation(fields: [developerId], references: [id], onDelete: Restrict)
  campaignId      String         @map("campaign_id")
  campaign        AppCampaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  discountPercent Int            @map("discount_percent")
  consumedAt      DateTime?      @map("consumed_at")
  paymentPending  Boolean        @default(false) @map("payment_pending")
  checkoutSessionId String?      @map("checkout_session_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@unique([promoCodeId, developerId])
  @@index([campaignId])
}

model DeveloperReferral {
  id            String    @id @default(cuid())
  inviterId     String    @map("inviter_id")
  inviter       User      @relation("DeveloperReferrer", fields: [inviterId], references: [id], onDelete: Restrict)
  developerId   String    @unique @map("developer_id")
  developer     User      @relation("DeveloperReferred", fields: [developerId], references: [id], onDelete: Restrict)
  qualifiedAt   DateTime? @map("qualified_at")
  qualifiedCampaignId String? @map("qualified_campaign_id")
  createdAt     DateTime  @default(now()) @map("created_at")
}

// One off-session card charge that funds a single tester slot on a pay-per-tester cohort.
model SlotCharge {
  id                    String           @id @default(cuid())
  campaignId            String           @map("campaign_id")
  campaign              AppCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  applicationId         String?          @map("application_id")
  stipendCents          Int              @map("stipend_cents")
  platformFeeCents      Int              @map("platform_fee_cents")
  processingFeeCents    Int              @map("processing_fee_cents")
  totalCents            Int              @map("total_cents")
  status                SlotChargeStatus @default(PENDING)
  stripePaymentIntentId String?          @unique @map("stripe_payment_intent_id")
  stripeRefundId        String?          @map("stripe_refund_id")
  transactionId         String?          @map("transaction_id")
  failureReason         String?          @map("failure_reason")
  refundedAt            DateTime?        @map("refunded_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([campaignId, status])
  @@index([status, createdAt])
  @@map("slot_charges")
}

model BalanceTopUp {
  id                      String           @id @default(cuid())
  userId                  String           @map("user_id")
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCents             Int              @map("credit_cents")
  processingFeeCents      Int              @map("processing_fee_cents")
  totalCents              Int              @map("total_cents")
  source                  String           @default("CHECKOUT")
  status                  SlotChargeStatus @default(PENDING)
  campaignId              String?          @map("campaign_id")
  stripeCheckoutSessionId String?          @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?          @unique @map("stripe_payment_intent_id")
  refundedCents           Int              @default(0) @map("refunded_cents")
  transactionId           String?          @map("transaction_id")
  failureReason           String?          @map("failure_reason")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("balance_top_ups")
}

model TaskInstruction {
  id                String        @id @default(cuid())
  campaignId        String
  campaign          AppCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepNumber        Int
  instructionTitle  String
  instructionDetail String
  proofType         TaskProofType
  minimumRep        Int           @default(0)

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

model CohortInstructionVersion {
  id          String       @id @default(cuid())
  campaignId  String
  campaign    AppCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  revision    Int
  directions  Json
  editedById  String
  createdAt   DateTime     @default(now())
  applications MissionApplication[]
  submissions  Submission[]

  @@unique([campaignId, revision])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  STARTED
}

model QuestReward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  amount    Int
  label     String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, createdAt])
}

model Referral {
  id          String    @id @default(cuid())
  inviterId   String
  inviter     User      @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  friendId    String    @unique
  friend      User      @relation("ReferralFriend", fields: [friendId], references: [id], onDelete: Cascade)
  qualifiedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([inviterId, qualifiedAt])
}

model MissionApplication {
  id           String            @id @default(cuid())
  campaignId   String
  campaign     AppCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  testerId     String
  tester       User              @relation(fields: [testerId], references: [id], onDelete: Cascade)
  note         String
  status       ApplicationStatus @default(PENDING)
  passReserved Boolean           @default(false)
  startBy      DateTime?
  instructionVersionId String?
  instructionVersion CohortInstructionVersion? @relation(fields: [instructionVersionId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([campaignId, testerId])
  @@index([campaignId, status])
}

model CommunityPost {
  id            String             @id @default(cuid())
  authorId      String
  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  hidden        Boolean            @default(false)
  publicVisible Boolean            @default(false)
  comments      CommunityComment[]
  reports       CommunityReport[]
  createdAt     DateTime           @default(now())

  @@index([hidden, createdAt])
}

model CommunityComment {
  id        String            @id @default(cuid())
  postId    String
  post      CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  hidden    Boolean           @default(false)
  reports   CommunityReport[]
  createdAt DateTime          @default(now())

  @@index([postId, createdAt])
}

model CommunityReport {
  id         String            @id @default(cuid())
  reporterId String
  reporter   User              @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean           @default(false)
  createdAt  DateTime          @default(now())

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([resolved, createdAt])
}

model Submission {
  id                  String            @id @default(cuid())
  campaignId          String
  campaign            AppCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  testerId            String
  tester              User              @relation("TesterSubmissions", fields: [testerId], references: [id], onDelete: Cascade)
  instructionVersionId String?
  instructionVersion CohortInstructionVersion? @relation(fields: [instructionVersionId], references: [id], onDelete: Restrict)
  proofImageUrl       String?
  recordingUrl        String?
  proofImageHash      String?
  feedbackText        String?
  osBuild             String?
  deviceModel         String?
  screenResolution    String?
  appBuildVersion     String?
  networkType         String?
  crashLogs           String?           @db.Text
  networkLogs         String?           @db.Text
  hardwareStatus      HardwareIntegrity @default(UNVERIFIED)
  gpuRenderer         String?
  isTouchCapable      Boolean?
  batteryLevel        Float?
  isLowPowerMode      Boolean?
  hardwareFlags       String[]          @default([])
  githubIssueUrl      String?
  audit               SubmissionAudit?
  status              SubmissionStatus  @default(PENDING)
  rejectionReason     String?
  denialReviewPending Boolean           @default(false) @map("denial_review_pending")
  denialRequestedAt   DateTime?         @map("denial_requested_at")
  denialResolvedAt    DateTime?         @map("denial_resolved_at")
  denialResolution    String?           @map("denial_resolution") @db.VarChar(1000)
  denialReviewerId    String?           @map("denial_reviewer_id")
  revisionRequestedAt DateTime?
  revisionStartedAt   DateTime?
  submittedAt         DateTime?         @map("submitted_at")
  payoutCents         Int
  claimedAt           DateTime          @default(now())
  expiresAt           DateTime
  reviewedAt          DateTime?
  createdAt           DateTime          @default(now())

  @@unique([campaignId, testerId])
  @@index([campaignId, status])
  @@index([testerId, status])
  @@index([proofImageHash])
  @@index([expiresAt, status])
  @@index([status, submittedAt])
}

model WalletTransaction {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents      Int
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  stripePaymentId  String?
  campaignId       String?
  campaign         AppCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  platformFeeCents Int?
  invoiceSnapshot  Json?
  taxAmountCents   Int?
  taxCode          String?
  taxAudit         Json?
  description      String
  createdAt        DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([type, status])
  @@index([stripePaymentId])
  @@index([campaignId])
}

// Immutable remote mutation identity survives Stripe's idempotency-key retention.
model BillingOperation {
  id             String   @id
  kind           String
  resourceId     String
  userId         String
  campaignId     String?
  ledgerId       String?
  paymentId      String?
  destinationId  String?
  amountCents    Int
  feeCents       Int      @default(0)
  state          String   @default("RESERVED")
  firstAttemptAt DateTime?
  remoteId       String?  @unique
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([resourceId, state])
  @@index([state, updatedAt])
  @@map("billing_operations")
}

model FundingReversal {
  paymentId     String   @id
  reversedCents Int      @default(0)
  disputedCents Int      @default(0)
  appliedCents  Int      @default(0)
  userId        String?
  campaignId    String?
  topUpId       String?
  updatedAt     DateTime @updatedAt

  @@index([topUpId])
  @@map("funding_reversals")
}

model FundingAllocation {
  id          String @id @default(cuid())
  topUpId     String
  slotChargeId String
  campaignId  String
  amountCents Int
  releasedCents Int @default(0)

  @@unique([topUpId, slotChargeId])
  @@index([campaignId])
  @@map("funding_allocations")
}

model BillingProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String   @db.VarChar(150)
  taxId        String?  @db.VarChar(80)
  billingEmail String?  @db.VarChar(254)
  addressLine1 String   @db.VarChar(200)
  addressLine2 String?  @db.VarChar(200)
  city         String   @db.VarChar(100)
  region       String?  @db.VarChar(100)
  postalCode   String   @db.VarChar(30)
  country      String   @db.VarChar(2)
  updatedAt    DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole
  category  String   @db.VarChar(40)
  subject   String   @db.VarChar(150)
  message   String   @db.VarChar(5000)
  route     String   @db.VarChar(1000)
  userAgent String   @db.VarChar(500)
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ClipProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String   @db.VarChar(1000)
  portfolioUrl String
  socialUrl    String
  specialties  String   @db.VarChar(200)
  updatedAt    DateTime @updatedAt
}

model ClipCampaign {
  id            String           @id @default(cuid())
  developerId   String
  developer     User             @relation(fields: [developerId], references: [id], onDelete: Restrict)
  title         String
  appUrl        String
  brief         String           @db.Text
  platform      String
  feeCents      Int
  revisionLimit Int              @default(2)
  deliveryDays  Int              @default(7)
  liveDays      Int              @default(30)
  minimumRep    Int              @default(0)
  open          Boolean          @default(true)
  createdAt     DateTime         @default(now())
  engagements   ClipEngagement[]
  messages      ClipMessage[]
  assets        ClipAsset[]

  @@index([open, createdAt])
  @@index([developerId, createdAt])
}

model ClipEngagement {
  id                  String       @id @default(cuid())
  campaignId          String
  campaign            ClipCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  creatorId           String
  creator             User         @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  note                String       @db.VarChar(1500)
  status              String       @default("APPLIED")
  feeCents            Int
  chargeCents         Int
  termsVersion        String       @default("clippers-v1-organic-90")
  termsAcceptedAt     DateTime
  revisionCount       Int          @default(0)
  reviewNote          String?
  dueAt               DateTime?
  reviewDueAt         DateTime?
  publishDueAt        DateTime?
  checkoutId          String?      @unique
  fundingAttempt      Int          @default(0)
  paymentIntentId     String?      @unique
  transferId          String?      @unique
  payoutTransactionId String?      @unique
  payoutDestinationId String?
  refundId            String?      @unique
  draftId             String?
  approvedDraftId     String?
  approvedAt          DateTime?
  proofId             String?
  publicationUrl      String?
  publicationId       String?
  publicationCode     String       @unique @default(cuid())
  verificationMethod  String?
  verifiedAt          DateTime?
  lastVerificationAt  DateTime?
  fundedAt            DateTime?
  paidAt              DateTime?
  licenseEndsAt       DateTime?
  disputeReason       String?      @db.VarChar(1500)
  disputeOpenedBy     String?
  statusBeforeDispute String?
  moderationNote      String?
  assets              ClipAsset[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([campaignId, creatorId])
  @@index([creatorId, updatedAt])
  @@index([campaignId, status])
}

model ClipMessage {
  id         String       @id @default(cuid())
  campaignId String
  campaign   ClipCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String       @db.VarChar(2000)
  createdAt  DateTime     @default(now())

  @@index([campaignId, createdAt])
  @@index([authorId, createdAt])
}

model ClipAsset {
  id           String          @id @default(cuid())
  campaignId   String
  campaign     ClipCampaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  engagementId String?
  engagement   ClipEngagement? @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  kind         String
  path         String          @unique
  name         String
  mimeType     String
  sizeBytes    Int
  ready        Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@index([campaignId, kind, createdAt])
  @@index([ownerId, createdAt])
}

model ClipSocialAccount {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  providerId       String
  displayName      String
  accessToken      String   @db.Text
  refreshToken     String   @db.Text
  expiresAt        DateTime
  refreshExpiresAt DateTime
  scope            String
  updatedAt        DateTime @updatedAt

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model ClipOAuthState {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventName  String
  path       String
  sessionKey String?
  referrer   String?
  userAgent  String?
  metadata   Json?
  visitorId  String?
  source     String?
  country    String?
  device     String?
  browser    String?
  os         String?
  loadMs     Int?
  createdAt  DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
}

// Growth engine (lib/growth). Everything generated starts in a review state; nothing publishes without a human approval.
enum ContentDropStatus {
  RESEARCHING
  DRAFTED
  APPROVED
  PUBLISHED
  REJECTED
}

enum SocialPlatform {
  TWITTER
  LINKEDIN
  INSTAGRAM
  TIKTOK
}

enum SocialQueueStatus {
  PENDING_APPROVAL
  MANUAL
  QUEUED
  PUBLISHED
  REJECTED
  FAILED
}

enum AdAuditAction {
  MAINTAINED
  ALERTED
  PAUSED
}

model ContentDrop {
  id            String            @id @default(cuid())
  title         String            @db.VarChar(200)
  targetKeyword String            @map("target_keyword") @db.VarChar(200)
  slug          String            @unique @db.VarChar(120)
  status        ContentDropStatus @default(RESEARCHING)
  markdownBody  String?           @map("markdown_body")
  metadata      Json?
  research      Json?
  reviewNote    String?           @map("review_note") @db.VarChar(1000)
  externalUrl   String?           @map("external_url") @db.VarChar(1000)
  approvedAt    DateTime?         @map("approved_at")
  publishedAt   DateTime?         @map("published_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  socialPosts   SocialQueue[]

  @@index([status, createdAt])
  @@index([targetKeyword])
  @@map("content_drops")
}

model SocialQueue {
  id            String            @id @default(cuid())
  contentDropId String?           @map("content_drop_id")
  contentDrop   ContentDrop?      @relation(fields: [contentDropId], references: [id], onDelete: SetNull)
  platform      SocialPlatform
  postText      String            @map("post_text") @db.VarChar(3000)
  mediaUrls     String[]          @default([]) @map("media_urls")
  linkUrl       String?           @map("link_url") @db.VarChar(500)
  videoScript   Json?             @map("video_script")
  scheduledTime DateTime          @map("scheduled_time")
  status        SocialQueueStatus @default(PENDING_APPROVAL)
  externalId    String?           @map("external_id") @db.VarChar(200)
  lastError     String?           @map("last_error") @db.VarChar(1000)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, scheduledTime])
  @@index([contentDropId])
  @@map("social_queue")
}

model AdAudit {
  id           String        @id @default(cuid())
  provider     String        @db.VarChar(40)
  campaignId   String        @map("campaign_id") @db.VarChar(120)
  campaignName String        @map("campaign_name") @db.VarChar(300)
  spend        Decimal       @db.Decimal(12, 2)
  impressions  Int
  conversions  Int
  cpa          Decimal?      @db.Decimal(12, 2)
  thresholdCpa Decimal       @map("threshold_cpa") @db.Decimal(12, 2)
  actionTaken  AdAuditAction @map("action_taken")
  reason       String        @db.VarChar(500)
  timestamp    DateTime      @default(now())

  @@index([campaignId, timestamp])
  @@index([actionTaken, timestamp])
  @@map("ad_audits")
}

enum SubmissionAuditStatus {
  PENDING
  APPROVED
  NEEDS_CLARIFICATION
  FLAGGED_FRAUD
  REJECTED
}

enum DropSpecStatus {
  DRAFT
  GENERATING
  READY
}

// AI review of a tester's proof. Advisory: APPROVED/REJECTED are recommendations for the developer, never payout decisions.
// PENDING means the AI has not produced a verdict yet (not run, or Gemini failed and it is queued for retry/manual review).
model SubmissionAudit {
  id                String                @id @default(cuid())
  submissionId      String                @unique
  submission        Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  qualityScore      Int                   @default(0)
  status            SubmissionAuditStatus @default(PENDING)
  reproductionValid Boolean               @default(false)
  isDuplicate       Boolean               @default(false)
  duplicateRefId    String?
  missingFields     String[]              @default([])
  feedbackToTester  String?               @db.Text
  fraudRiskScore    Int                   @default(0)
  fraudFlags        String[]              @default([])
  fraudExplanation  String?               @db.Text
  mediaChecked      Boolean               @default(false)
  model             String?               @db.VarChar(80)
  attempts          Int                   @default(0)
  lastError         String?               @db.VarChar(1000)
  autoClarifiedAt   DateTime?
  humanClearedAt    DateTime?
  humanClearedById  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, updatedAt])
}

model CampaignSynthesis {
  id                   String      @id @default(cuid())
  campaignId           String      @unique
  campaign             AppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  totalSubmissions     Int
  validBugsCount       Int
  p0Count              Int
  p1Count              Int
  p2Count              Int
  executiveSummary     String      @db.Text
  clusteredThemesJson  Json
  githubMarkdownExport String      @db.Text
  model                String?     @db.VarChar(80)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}
