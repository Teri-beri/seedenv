generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TESTER
  DEVELOPER
  ADMIN
}

enum RankTier {
  ALPHA_SEEDER
  CORE_VALIDATOR
  APEX_ARCHITECT
}

enum PlatformType {
  TESTFLIGHT
  WEB_STAGING
  PLAY_STORE
}

enum CampaignStatus {
  DRAFT
  ESCROW_PENDING
  ACTIVE
  PAUSED
  COMPLETED
}

enum TaskProofType {
  SCREENSHOT
  TEXT_FEEDBACK
  ACTION_LINK
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum TransactionType {
  ESCROW_DEPOSIT
  BOUNTY_PAYOUT
  PLATFORM_FEE
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  emailVerified          DateTime?
  name                   String?
  image                  String?
  role                   UserRole            @default(TESTER)
  username               String              @default("SeedEnv Member")
  avatarUrl              String?
  walletBalanceCents     Int                 @default(0)
  xpPoints               Int                 @default(0)
  rankTier               RankTier            @default(ALPHA_SEEDER)
  streakDays             Int                 @default(1)
  lastActiveDate         DateTime            @default(now())
  stripeCustomerId       String?
  stripeConnectAccountId String?
  campaigns              AppCampaign[]       @relation("DeveloperCampaigns")
  submissions            Submission[]        @relation("TesterSubmissions")
  transactions           WalletTransaction[]
  accounts               Account[]
  sessions               Session[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([role])
  @@index([rankTier, xpPoints])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AppCampaign {
  id               String            @id @default(cuid())
  developerId      String
  developer        User              @relation("DeveloperCampaigns", fields: [developerId], references: [id], onDelete: Cascade)
  title            String
  platform         PlatformType
  appUrl           String
  iconUrl          String?
  targetVibe       String
  description      String
  totalBudgetUsd   Float
  bountyPerTaskUsd Float
  platformFeeUsd   Float
  totalSlots       Int
  claimedSlots     Int               @default(0)
  completedSlots   Int               @default(0)
  status           CampaignStatus    @default(DRAFT)
  instructions     TaskInstruction[]
  submissions      Submission[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  expiresAt        DateTime

  @@index([developerId, status])
  @@index([status, expiresAt])
  @@index([platform])
}

model TaskInstruction {
  id                String        @id @default(cuid())
  campaignId        String
  campaign          AppCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepNumber        Int
  instructionTitle  String
  instructionDetail String
  proofType         TaskProofType

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

model Submission {
  id              String           @id @default(cuid())
  campaignId      String
  campaign        AppCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  testerId        String
  tester          User             @relation("TesterSubmissions", fields: [testerId], references: [id], onDelete: Cascade)
  proofImageUrl   String?
  proofImageHash  String?
  feedbackText    String?
  status          SubmissionStatus @default(PENDING)
  rejectionReason String?
  payoutCents     Int
  claimedAt       DateTime         @default(now())
  expiresAt       DateTime
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@unique([campaignId, testerId])
  @@index([campaignId, status])
  @@index([testerId, status])
  @@index([proofImageHash])
  @@index([expiresAt, status])
}

model WalletTransaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  stripePaymentId String?
  description     String
  createdAt       DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([type, status])
  @@index([stripePaymentId])
}
