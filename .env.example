DATABASE_URL="postgresql://seedenv_user:YOUR_PASSWORD@YOUR_RENDER_HOST/seedenv"
NEXT_PUBLIC_APP_URL="https://seedenv.com"
NEXTAUTH_URL="https://seedenv.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
RESEND_API_KEY="re_your_resend_api_key"
AUTH_EMAIL_FROM="SeedEnv Authentication <auth@seedenv.com>"
GITHUB_ID="your_github_oauth_client_id"
GITHUB_SECRET="your_github_oauth_client_secret"
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
SEEDENV_PREVIEW_USER_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Enable first in a staging deployment using Stripe test credentials and a test database.
SEEDENV_STRIPE_TAX_ENABLED="0"
# Set only after approving the Florida QA/platform-service policy. Other regions fail closed.
SEEDENV_FLORIDA_QA_TAX_POLICY_CONFIRMED="0"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROOF_BUCKET="proof-screenshots"
SUPABASE_CLIPPERS_BUCKET="seedenv-clippers"
CLIPPERS_ENABLED="false"
CLIPPERS_STRIPE_WEBHOOK_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="https://seedenv.com/api/clippers/tiktok/callback"
CLIPPERS_TOKEN_KEY=""

# --- Growth engine (SEO drafts, social scheduling, ad kill-switch). Inert until GROWTH_ENABLED="true". ---
GROWTH_ENABLED="false"
# 32+ random chars; signs the Approve/Reject review links. Generate: openssl rand -base64 48
GROWTH_APPROVAL_SECRET=""
# Comma-separated seed keywords the research agent chooses from (90-day cooldown per keyword).
GROWTH_SEED_KEYWORDS=""
GROWTH_CONTENT_MIN_INTERVAL_DAYS="6"
GROWTH_SITE_URL="https://seedenv.com"
# Development only falls back to mock adapters automatically; never set this in production.
GROWTH_ALLOW_MOCKS="false"
# LLM: reuses GEMINI_API_KEY from the support assistant.
GROWTH_LLM_MODEL="gemini-3.1-flash-lite"
# Keyword data (https://dataforseo.com, pay-as-you-go). 2840 = United States.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
DATAFORSEO_LOCATION_CODE="2840"
# Social scheduling aggregator (https://www.ayrshare.com); connect X, LinkedIn and Instagram in its dashboard.
# Optional: without it, approved posts switch to manual posting (copy text + "Mark as posted"). TikTok is always manual.
AYRSHARE_API_KEY=""
# Optional: also POST approved articles to an external CMS (signed with X-Growth-Signature). Leave empty to publish on /blog.
CMS_PUBLISH_WEBHOOK_URL=""
CMS_PUBLISH_WEBHOOK_SECRET=""
# Meta Ads (system-user token with ads_read + ads_management).
META_ADS_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
META_GRAPH_VERSION="v26.0"
META_CONVERSION_ACTION="offsite_conversion.fb_pixel_complete_registration"
AD_THRESHOLD_CPA="25"
AD_MIN_SPEND="10"
AD_ALERT_RATIO="0.8"
AD_LOOKBACK="last_3d"
# Keep "false" (alert only) until you trust the thresholds; "true" lets the engine pause campaigns.
AD_KILLSWITCH_ENFORCE="false"
# Review/alert channels (any combination).
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- QA assistant (submission audits, cohort drafting, release reports). Uses GEMINI_API_KEY. ---
# Optional model overrides (default gemini-3.1-flash-lite). The vision model must accept images and video.
GEMINI_QA_TEXT_MODEL=""
GEMINI_QA_VISION_MODEL=""
# Optional daily cap on developer-triggered AI calls per server instance (default 2000).
QA_AI_DAILY_LIMIT=""
# Set to "1" to stop the background audit retry / release-report sweep.
SEEDENV_DISABLE_QA_AI=""
