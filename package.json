{
  "name": "seedenv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm install --include=dev && prisma generate && next build",
    "build:local": "prisma generate && next build",
    "start": "prisma migrate deploy && tsx scripts/ensure-schema.ts && next start",
    "lint": "eslint",
    "growth": "tsx scripts/growth-runner.ts",
    "test:growth": "node --experimental-test-module-mocks --import tsx --test scripts/growth.test.ts",
    "test:tester": "node --import tsx --test scripts/tester-console.test.ts",
    "test:tester-views": "node --experimental-test-module-mocks --import tsx --test scripts/tester-console.test.ts scripts/tester-views.test.ts",
    "test:launch": "node --conditions=react-server --experimental-test-module-mocks --import tsx --test scripts/launch-readiness.test.ts",
    "test:cohort-promos": "node --conditions=react-server --experimental-test-module-mocks --import tsx --test --test-concurrency=1 scripts/cohort-promos.test.ts scripts/developer-referral-onboarding.test.ts scripts/resilient-referrals.test.ts",
    "test:launch-circle": "node --experimental-test-module-mocks --import tsx --test --test-concurrency=1 scripts/launch-circle.test.ts",
    "test:quests": "node --import tsx --test scripts/quest-rules.test.ts scripts/quest-ledger.integration.test.ts",
    "test:clippers": "node --conditions=react-server --experimental-test-module-mocks --import tsx --test scripts/clipper-rules.test.ts scripts/clipper-lifecycle.integration.test.ts scripts/clipper-payments.integration.test.ts scripts/clipper-tiktok.integration.test.ts scripts/clipper-storage.integration.test.ts",
    "setup:clippers-storage": "tsx scripts/setup-clippers-storage.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:goddesses-beta": "tsx scripts/seed-goddesses-beta.ts",
    "user:developer": "tsx scripts/set-user-role.ts --role DEVELOPER"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "6.12.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.116.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "prisma": "6.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.27.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
